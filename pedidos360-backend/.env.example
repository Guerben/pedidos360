# =========================================================================
# Variables de Entorno para Docker Compose (PostgreSQL 16 + RabbitMQ)
# =========================================================================

# Credenciales de PostgreSQL (usadas por docker-compose)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_DATABASES=pedidos360_db,auditoria_db

# Credenciales / host usados por Spring Boot (productor y consumer)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres

# Credenciales de RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
